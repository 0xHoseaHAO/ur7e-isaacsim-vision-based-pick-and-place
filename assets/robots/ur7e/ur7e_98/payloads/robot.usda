#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "ur7e"
    doc = """Generated from Composed Stage of root layer /tmp/tmp51occn_g/ur7e.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_ur7e_0r06qy8f/usdex_ur7e/ur7e.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_ur7e_0r06qy8f/temp_ur7e/ur7e.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "ur7e" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </ur7e/Physics/tn__base_linkbase_link_inertia_kc0>,
        </ur7e/Physics/shoulder_pan_joint>,
        </ur7e/Physics/shoulder_lift_joint>,
        </ur7e/Physics/elbow_joint>,
        </ur7e/Physics/wrist_1_joint>,
        </ur7e/Physics/wrist_2_joint>,
        </ur7e/Physics/wrist_3_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </ur7e/Geometry/world/base_link/base_link_inertia>,
        </ur7e/Geometry/world/base_link/base_link_inertia/shoulder_link>,
        </ur7e/Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link>,
        </ur7e/Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link/forearm_link>,
        </ur7e/Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link/forearm_link/wrist_1_link>,
        </ur7e/Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link/forearm_link/wrist_1_link/wrist_2_link>,
        </ur7e/Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link/forearm_link/wrist_1_link/wrist_2_link/wrist_3_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "world"
        {
            over "base_link"
            {
                over "base_link_inertia" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "shoulder_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "upper_arm_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "forearm_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "wrist_1_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "wrist_2_link" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                        over "wrist_3_link" (
                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                            over "ft_frame" (
                                                prepend apiSchemas = ["IsaacSiteAPI"]
                                            )
                                            {
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "tn__base_linkbase_link_inertia_kc0" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "shoulder_pan_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "shoulder_lift_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "elbow_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_2_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_3_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

